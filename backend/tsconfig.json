{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"allowImportingTsExtensions": false,
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"sourceMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
